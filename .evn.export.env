DB_HOST=xxx	# IP หรือ Host ของฐานข้อมูล
DB_NAME=xxx	# ชื่อฐานข้อมูล
DB_USER=xxx	# ชื่อเข้าใช้งานฐานข้อมูล
DB_PASS=xxx	# รหัสผ่านเข้าใช้งานฐานข้อมูล
DB_CHARSET=utf8mb4
DB_PORT=3306

# เพิ่มบรรทัดเหล่านี้ต่อท้ายไฟล์ .env ที่มีอยู่แล้ว (DB_HOST, DB_NAME, ...)

# ===== Health ID (moph.id.th) =====
HEALTH_CLIENT_ID=xxx
HEALTH_CLIENT_SECRET=xxx
HEALTH_REDIRECT_URI=https://website.hangchathospital.com/savefile/oauth_callback.php

# ===== Provider ID (provider.id.th) =====
PROVIDER_CLIENT_ID=xxx
PROVIDER_CLIENT_SECRET=xxx

# รหัสหน่วยงานที่อนุญาตให้ login ผ่าน Provider ID ได้ (คั่นด้วยจุลภาคถ้ามีหลายหน่วยงาน)
ALLOWED_HOSPCODES=xxxxx	# รหัสหน่วยงาน

# ตั้งเป็น 1 ชั่วคราวเพื่อดูข้อมูลโปรไฟล์ดิบที่ได้จาก Provider ID บนหน้าจอตอน login ไม่ผ่าน
# (ไว้หาชื่อ field รหัสหน่วยงานที่ถูกต้อง) แล้วเปลี่ยนกลับเป็น 0 ก่อนใช้งานจริง
OAUTH_DEBUG=0